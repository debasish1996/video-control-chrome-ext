{
    "manifest_version": 3,
    "name": "Fullscreen Video Controls",
    "description": "Adds a draggable control panel for HTML5 videos on the current tab.",
    "version": "1.1.0",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_title": "Video Controls",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png"
        },
        "default_popup": "popup.html"
    }
}